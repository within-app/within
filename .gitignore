# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (niemals echte Credentials committen!)
.env
.env*.local
.env.localdev

# root certificate exported by the compose "certificate" service (device install; not a secret, but per-installation)
certificate/

# MCP configuration (contains sensitive tokens)
.mcp.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# git worktrees
.worktrees/

# playwright e2e
tests/e2e/.auth-state.json
tests/e2e/test-results/
tests/e2e/report/

# MapLibre worker pair — copied from node_modules by scripts/copy-map-worker.mjs
public/map/*.mjs
