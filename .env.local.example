# ─────────────────────────────────────────────────────────────────────────────
# Within — local dev environment for `npm run dev`
# Copy this file to .env.local and fill in your values.
#
# This is for running the app directly with `npm run dev` against a Postgres
# you provide yourself. If you'd rather run the whole app in Docker too, use
# docker-compose.dev.yml instead — see docs/local-dev-docker.md.
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Without it, every data route answers 503 —
# there is no mock fallback.
#
# Easiest way to get a Postgres to point this at: start just the database
# from the dev stack (uses the password from .env.localdev, see
# .env.localdev.example):
#   docker compose -f docker-compose.dev.yml up -d db
DATABASE_URL=postgresql://journal:devsecret@localhost:5432/journal

# Login password (plain text, hashed on first start) and cookie-signing
# secret — both required to actually log in. See .env.example for details.
APP_PASSWORD=localtest
SESSION_SECRET=dev-session-secret-not-for-production-ok
