# ══════════════════════════════════════════════════════════════════════════════
# Within — Environment Variables
#
# Compose users don't need this file — settings live in docker-compose.yml.
# This file documents the environment variables for developers and bare-metal
# installs (running `npm run dev` / `npm start` against your own Postgres).
#
# Never commit a copy of this file with real values filled in.
# ══════════════════════════════════════════════════════════════════════════════

# ──────────────────────────────────────────────────────────────────────────────
# DATABASE (required)
# ──────────────────────────────────────────────────────────────────────────────

# PostgreSQL connection string. Without it, every data route answers 503 —
# there is no mock fallback.
DATABASE_URL=postgresql://journal:<password>@localhost:5432/journal

# ──────────────────────────────────────────────────────────────────────────────
# LOGIN (required — one of the two)
# ──────────────────────────────────────────────────────────────────────────────

# The login password, in plain text. The app hashes it (bcrypt) on first start
# and stores the hash in the database — the line can be left blank afterwards.
# Changing it here and restarting replaces the stored hash.
APP_PASSWORD=

# Alternative: a pre-computed bcrypt hash, for setups that don't want a
# plain-text password sitting in a file.
# Generate one: node -e "const b=require('bcryptjs');b.hash('YOUR_PASSWORD',12).then(console.log)"
# APP_PASSWORD_HASH=

# Random string used to sign session cookies (at least 32 characters).
# Generate one: openssl rand -base64 32
SESSION_SECRET=

# ──────────────────────────────────────────────────────────────────────────────
# TIME ZONE (optional, default UTC)
# ──────────────────────────────────────────────────────────────────────────────

# IANA time zone name that calendar days and clock times are calculated in
# (e.g. Europe/Berlin, America/New_York). Without it, the app uses UTC — west
# of Greenwich, every evening entry then lands under the next day. An invalid
# name stops the app from starting.
# APP_TIMEZONE=Europe/Berlin

# ──────────────────────────────────────────────────────────────────────────────
# SESSION (optional)
# ──────────────────────────────────────────────────────────────────────────────

# How long a session stays valid, in hours.
# Default: 24
# SESSION_MAX_AGE_HOURS=24

# Adds the Secure flag to the session cookie, so browsers refuse to send it
# over plain HTTP. Default: false. Also turned on automatically whenever
# TRUSTED_PROXY_COUNT is above 0 (see below).
# SECURE_COOKIES=true

# ──────────────────────────────────────────────────────────────────────────────
# REVERSE PROXY / RATE LIMITING (optional)
# ──────────────────────────────────────────────────────────────────────────────

# Number of trusted reverse-proxy hops in front of the app. Set to 1 when a
# proxy (e.g. Caddy, nginx) sits in front and forwards the real client IP via
# X-Forwarded-For — otherwise every request looks like it comes from the same
# place, and the per-IP login rate limit can lock out every user at once.
# Default (0): every request is treated as untrusted and shares one bucket.
# TRUSTED_PROXY_COUNT=1

# Max. login attempts per minute per IP (brute-force protection).
# Default: 5
# RATE_LIMIT_LOGIN_MAX=5

# Max. login attempts per minute across ALL IPs combined — a backstop for
# when TRUSTED_PROXY_COUNT is 0 and every request shares one bucket.
# Default: 100
# RATE_LIMIT_LOGIN_GLOBAL_MAX=100

# Max. API requests per minute per IP (general abuse protection).
# Default: 60
# RATE_LIMIT_API_MAX=60

# ──────────────────────────────────────────────────────────────────────────────
# MEDIA UPLOADS (optional)
# ──────────────────────────────────────────────────────────────────────────────

# Max. file size per media type, in megabytes.
# Defaults: images 20, video 100, audio 50
# MAX_IMAGE_SIZE_MB=20
# MAX_VIDEO_SIZE_MB=100
# MAX_AUDIO_SIZE_MB=50

# Paths to the ffmpeg / ffprobe binaries, used for video thumbnails and
# duration lookups. Only needed if they're not on the PATH already.
# Defaults: ffmpeg, ffprobe
# FFMPEG_PATH=/usr/bin/ffmpeg
# FFPROBE_PATH=/usr/bin/ffprobe

# ──────────────────────────────────────────────────────────────────────────────
# RUNTIME (optional)
# ──────────────────────────────────────────────────────────────────────────────

# production | development | test
# Default: development
# NODE_ENV=production
