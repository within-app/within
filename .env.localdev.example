# ══════════════════════════════════════════════════════════════════════════════
# Local dev credentials for docker-compose.dev.yml
#
# ⚠️  ONLY FOR LOCAL DEVELOPMENT — never use these values in production.
#     Copy to .env.localdev (git-ignored), then:
#       docker compose -f docker-compose.dev.yml --env-file .env.localdev up --build
#
# App login password: localtest
# App URL:           http://localhost:4000
# ══════════════════════════════════════════════════════════════════════════════

# Postgres password for the local dev container
POSTGRES_PASSWORD=devsecret

# DATABASE_URL for the app container (references the db service by hostname)
DATABASE_URL=postgresql://journal:devsecret@db:5432/journal

# Time zone for calendar days and clock times (IANA name). UTC if unset.
APP_TIMEZONE=Europe/Berlin

# Session signing secret (must be ≥32 chars)
SESSION_SECRET=dev-session-secret-not-for-production-ok

# bcrypt hash of the dev app password "localtest" (rounds=12)
# Single-quoted to prevent Docker Compose from interpreting $ as variable references.
# To use a different password: node -e "const b=require('bcryptjs'); b.hash('YOUR_PW',12).then(console.log)"
APP_PASSWORD_HASH='$2b$12$AP01wYFfhWPlEbc3mHg2leevTob3U6LoYbQWkoH1.MqCfa8MA6aiu'
